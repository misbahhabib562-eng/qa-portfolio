{
  "name": "qa-portfolio",
  "version": "1.0.0",
  "description": "QA portfolio: manual test documentation, Playwright UI and API automation, Postman and JMeter.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "test:postman": "newman run postman/restful-booker.postman_collection.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "newman": "^6.2.1"
  },
  "license": "MIT"
}
